{
 "app-id": "io.github.xXKuroiKenshiXx.MSPaint",
 "runtime": "org.freedesktop.Platform",
 "runtime-version": "25.08",
 "sdk": "org.freedesktop.Sdk",
 "command": "mspaint-rewritten-linux",
 "finish-args": ["--socket=wayland", "--socket=fallback-x11", "--share=ipc", "--device=dri", "--filesystem=xdg-pictures", "--socket=cups"],
 "modules": [{
  "name": "mspaint",
  "buildsystem": "simple",
  "build-commands": [
   "mkdir -p /app/lib/mspaint /app/bin /app/share/applications /app/share/icons/hicolor/scalable/apps /app/share/metainfo",
   "cp -a bundle/. /app/lib/mspaint/",
   "printf '#!/bin/sh\nexec /app/lib/mspaint/mspaint-rewritten-linux \"$@\"\n' > /app/bin/mspaint-rewritten-linux",
   "chmod +x /app/bin/mspaint-rewritten-linux",
   "install -m644 io.github.xXKuroiKenshiXx.MSPaint.desktop /app/share/applications/",
   "install -m644 io.github.xXKuroiKenshiXx.MSPaint.svg /app/share/icons/hicolor/scalable/apps/",
   "install -m644 io.github.xXKuroiKenshiXx.MSPaint.metainfo.xml /app/share/metainfo/"
  ],
  "sources": [
   {"type": "dir", "path": "../dist/mspaint-rewritten-linux", "dest": "bundle"},
   {"type": "file", "path": "io.github.xXKuroiKenshiXx.MSPaint.desktop"},
   {"type": "file", "path": "io.github.xXKuroiKenshiXx.MSPaint.svg"},
   {"type": "file", "path": "io.github.xXKuroiKenshiXx.MSPaint.metainfo.xml"}
  ]
 }]
}
